      }
    },
    {
      "id": "kp_赋值法",
      "label": "KnowledgePoint",
      "properties": {
        "name": "赋值法",
        "content": "赋值法是通过给未知数赋值来简化计算的方法。常用于工程问题和行程问题。",
        "keywords": "[\"\\u8d4b\\u503c\", \"\\u5de5\\u7a0b\\u95ee\\u9898\", \"\\u884c\\u7a0b\\u95ee\\u9898\"]",
